# Copy to .env and fill in. .env is gitignored; never commit real keys.
ANTHROPIC_API_KEY=
# Optional: Product Hunt developer token (producthunt.com/v2/oauth/applications). Empty = PH source skipped.
PRODUCT_HUNT_TOKEN=
# Only needed for `npm run local -- --send` and the Lambda (must be SES-verified identities)
DIGEST_TO=
DIGEST_FROM=
